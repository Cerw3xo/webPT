{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matej-cervenka",
  "account_id": "8ad8b0076e5e8bc4836f3e58b93697a6",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CONTACT_EMAIL": "matejcervenka@icloud.com"
  },
  "observability": {
    "enabled": true
  }
}
